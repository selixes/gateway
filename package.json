{
  "name": "selixes-gateway",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "deploy:client": "node scripts/automations/deploy-client.js"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.9",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "imap-simple": "^5.1.0",
    "mailparser": "^3.9.15",
    "pg": "^8.23.0",
    "puppeteer": "^25.7.0",
    "puppeteer-screen-recorder": "^3.0.6"
  }
}
